# --- Gemini access --------------------------------------------------------------
# Free-tier key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Vertex AI instead (paid GCP project): set the three lines below and drop GOOGLE_API_KEY
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Web UI port on your machine (http://localhost:APP_PORT) ---------------------
APP_PORT=8095

# --- Models (free-tier friendly defaults) -----------------------------------------
# Auto-updating aliases; gemini-2.5-* models were retired for new keys on 2026-10-16.
ORCHESTRATOR_MODEL=gemini-flash-latest
SUBAGENT_MODEL=gemini-flash-lite-latest
# Retries on 429 rate limits / 5xx with backoff 5s, 10s, 20s, 40s
LLM_RETRY_ATTEMPTS=5

# --- Database (local runs only; docker compose always uses its Postgres) -----------
# Default: SQLite file ./supply_chain.db, auto-created and seeded.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/supply_chain
